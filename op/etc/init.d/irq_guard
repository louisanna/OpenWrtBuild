#!/bin/sh /etc/rc.common
# irq_guard - run the NIC IRQ affinity daemon under procd supervision
#
# The daemon itself lives in /usr/raspberry/check_updates.sh:
#   /etc/init.d/irq_guard start|stop|restart|enable|disable
#   /etc/init.d/irq_guard mapping      # show current queue->CPU mapping

USE_PROCD=1
START=99
STOP=10

start_service() {
	# irqbalance would fight the static mapping
	if [ -x /etc/init.d/irqbalance ]; then
		/etc/init.d/irqbalance stop >/dev/null 2>&1
		/etc/init.d/irqbalance disable >/dev/null 2>&1
	fi
	command -v killall >/dev/null && killall irqbalance 2>/dev/null

	# clean up a pre-procd instance left over from an older version
	if [ -f /var/run/irq_guard.pid ]; then
		kill "$(cat /var/run/irq_guard.pid)" 2>/dev/null
		rm -f /var/run/irq_guard.pid
	fi

	procd_open_instance
	procd_set_param command /bin/sh /usr/raspberry/check_updates.sh
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

EXTRA_COMMANDS="mapping"
EXTRA_HELP="	mapping	Show current NIC queue/IRQ/CPU mapping"

mapping() {
	/bin/sh /usr/raspberry/check_updates.sh --status
}
