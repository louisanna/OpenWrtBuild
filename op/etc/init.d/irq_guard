#!/bin/sh /etc/rc.common

START=99
PIDFILE=/var/run/irq_guard.pid

# 默认网卡名，可被自动探测覆盖
WAN_IF="eth0"
LAN_IF="eth1"

start() {
    [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null && {
        echo "irq_guard already running."
        return 1
    }
    rm -f "$PIDFILE"
    daemon &
    echo $! > "$PIDFILE"
    echo "irq_guard started."
}

stop() {
    [ ! -f "$PIDFILE" ] && { echo "irq_guard not running."; return 1; }
    local pid
    pid=$(cat "$PIDFILE" 2>/dev/null)
    if [ -z "$pid" ]; then
        rm -f "$PIDFILE"
        echo "stale PID file removed."
        return 1
    fi
    echo "Stopping irq_guard (PID $pid)..."
    kill -TERM "$pid" 2>/dev/null
    sleep 2
    kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null
    rm -f "$PIDFILE"
    echo "irq_guard stopped."
}

write_if_changed() {
    local file="$1" value="$2" cur
    [ -f "$file" ] || return
    read -r cur < "$file" 2>/dev/null
    [ "$cur" != "$value" ] && echo "$value" > "$file" 2>/dev/null
}

# 获取网卡所有队列中断号（排序后）
get_nic_irqs() {
    local iface="$1"
    # 优先从 msi_irqs 目录获取，并过滤出队列中断
    if [ -d "/sys/class/net/$iface/device/msi_irqs" ]; then
        for irq in $(ls "/sys/class/net/$iface/device/msi_irqs/" 2>/dev/null | sort -n); do
            # 检查 /proc/interrupts 中该中断行是否包含队列命名
            if grep -qE "^[[:space:]]*${irq}:.*${iface}-(TxRx|rx|tx)-[0-9]+" /proc/interrupts 2>/dev/null; then
                echo "$irq"
            fi
        done
        return
    fi
    # 回退：直接从 /proc/interrupts 提取队列中断
    grep -E "(^| )${iface}-(TxRx|rx|tx)-[0-9]+" /proc/interrupts | awk -F: '{print $1}' | tr -d ' '
}

# 调优网卡 Ring Buffer 和中断合并
tune_ethtool() {
    local iface="$1" target=4096
    local max_rx max_tx

    max_rx=$(ethtool -g "$iface" 2>/dev/null | awk '/Pre-set maximums:/ {f=1; next} /Current hardware settings:/ {f=0} f && /RX:/ {print $NF}')
    max_tx=$(ethtool -g "$iface" 2>/dev/null | awk '/Pre-set maximums:/ {f=1; next} /Current hardware settings:/ {f=0} f && /TX:/ {print $NF}')

    [ -n "$max_rx" ] && { ethtool -G "$iface" rx $((max_rx < target ? max_rx : target)) 2>/dev/null || true; }
    [ -n "$max_tx" ] && { ethtool -G "$iface" tx $((max_tx < target ? max_tx : target)) 2>/dev/null || true; }

    ethtool -c "$iface" 2>/dev/null | grep -q 'rx-usecs' && {
        ethtool -C "$iface" rx-usecs 16 tx-usecs 16 2>/dev/null || true
    }
}

# ============================================================================
# 核心优化：统一配置单个网卡的中断亲和性、RPS 和 XPS
# 参数：
#   $1 - 网卡名称
#   $2 - 起始 CPU 编号（用于轮转）
#   $3 - 是否强制跳过 CPU0 ("yes" / 其他)
#   $4 - RPS 掩码（可选，若提供则所有队列的 RPS 使用此掩码，否则与中断同核）
# 说明：
#   - 每个队列的硬中断、RPS、XPS 会绑定到同一个 CPU（或 RPS 使用指定的多核掩码）
#   - 当 $3 = "yes" 时，若计算出的目标 CPU 为 0，则顺延到 1（仅当 core 数 > 1）
#   - 中断号列表按队列顺序对应，若中断号不足则仅配置 RPS/XPS
# ============================================================================
bind_nic_full() {
    local iface="$1" start_cpu="$2" skip_cpu0="$3" rps_mask="$4"
    local q=0
    local irq_list
    irq_list=$(get_nic_irqs "$iface")
    set -- $irq_list

    while [ -d "/sys/class/net/$iface/queues/rx-$q" ]; do
        # 计算目标 CPU（轮转）
        local target_cpu=$(( (start_cpu + q) % cores ))
        # 若需要跳过 CPU0 且当前目标为 0，则顺延到 1（仅当核心数 > 1）
        if [ "$skip_cpu0" = "yes" ] && [ "$target_cpu" -eq 0 ] && [ "$cores" -gt 1 ]; then
            target_cpu=1
        fi

        # 获取对应的中断号（若顺序对应不上，则忽略）
        local irq="$1"
        shift 2>/dev/null || irq=""

        # ---- 设置中断亲和性 ----
        if [ -n "$irq" ]; then
            if [ -f "/proc/irq/$irq/smp_affinity_list" ]; then
                write_if_changed "/proc/irq/$irq/smp_affinity_list" "$target_cpu"
            else
                write_if_changed "/proc/irq/$irq/smp_affinity" "$(printf '%x' $((1 << target_cpu)))"
            fi
        fi

        # ---- 设置 RPS ----
        local rx_dir="/sys/class/net/$iface/queues/rx-$q"
        [ -d "$rx_dir" ] && {
            if [ -n "$rps_mask" ]; then
                # 使用指定的多核掩码（如 WAN 口）
                write_if_changed "$rx_dir/rps_cpus" "$rps_mask"
            else
                # 使用与中断相同的单核掩码
                write_if_changed "$rx_dir/rps_cpus" "$(printf '%x' $((1 << target_cpu)))"
            fi
            write_if_changed "$rx_dir/rps_flow_cnt" "$rfs_queue"
        }

        # ---- 设置 XPS（始终与中断同核） ----
        local tx_dir="/sys/class/net/$iface/queues/tx-$q"
        [ -d "$tx_dir" ] && {
            write_if_changed "$tx_dir/xps_cpus" "$(printf '%x' $((1 << target_cpu)))"
        }

        q=$((q + 1))
    done
}

# 自动探测网卡（如果默认名称不存在）
detect_interfaces() {
    if [ ! -d "/sys/class/net/$WAN_IF" ] || [ ! -d "/sys/class/net/$LAN_IF" ]; then
        local eth_list
        eth_list=$(ls /sys/class/net | grep -E '^(eth|enp)' | head -2)
        if [ -n "$eth_list" ]; then
            WAN_IF=$(echo "$eth_list" | sed -n '1p')
            LAN_IF=$(echo "$eth_list" | sed -n '2p')
            echo "Auto-detected interfaces: WAN=$WAN_IF LAN=$LAN_IF"
        fi
    fi
}

daemon() {
    trap 'exit 0' SIGTERM

    # 如果默认网卡不存在，尝试自动探测
    detect_interfaces

    local wait=0
    while [ ! -d "/sys/class/net/$WAN_IF/queues/rx-0" ] || [ ! -d "/sys/class/net/$LAN_IF/queues/rx-0" ]; do
        sleep 1
        wait=$((wait + 1))
        [ "$wait" -ge 60 ] && exit 1
    done

    # 直接禁用 irqbalance
    if [ -x /etc/init.d/irqbalance ]; then
        /etc/init.d/irqbalance stop 2>/dev/null
        /etc/init.d/irqbalance disable 2>/dev/null
    fi
    killall irqbalance 2>/dev/null

    local cores rps_target rfs_global rfs_queue
    cores=$(grep -c ^processor /proc/cpuinfo)

    # RPS target 跳过 CPU0（用于 WAN 口的 RPS 多核分散）
    if [ "$cores" -le 1 ]; then
        rps_target=0
    else
        rps_target=$(printf "%x" $(( (1 << cores) - 2 )))
    fi

    # RFS 全局条目计算：可用内存/16，上限 262144，下限 32768
    local mem_kb
    mem_kb=$(awk '/MemAvailable/{print $2}' /proc/meminfo 2>/dev/null)
    if [ -n "$mem_kb" ] && [ "$mem_kb" -gt 0 ]; then
        rfs_global=$(( mem_kb / 16 ))
        [ "$rfs_global" -gt 262144 ] && rfs_global=262144
        [ "$rfs_global" -lt 32768 ] && rfs_global=32768
    else
        rfs_global=131072
    fi

    # 统计所有受管队列总数（WAN + LAN + pppoe-wan）
    local total_rx_queues=0
    for iface in $WAN_IF $LAN_IF; do
        if [ -d "/sys/class/net/$iface/queues/rx-0" ]; then
            local n=$(ls -d /sys/class/net/$iface/queues/rx-* 2>/dev/null | wc -l)
            total_rx_queues=$((total_rx_queues + n))
        fi
    done
    if [ -d /sys/class/net/pppoe-wan/queues/rx-0 ]; then
        local ppp_count=$(ls -d /sys/class/net/pppoe-wan/queues/rx-* 2>/dev/null | wc -l)
        total_rx_queues=$((total_rx_queues + ppp_count))
    fi

    # 计算每队列条目数（保底 1024）
    if [ "$total_rx_queues" -gt 0 ]; then
        rfs_queue=$(( rfs_global / total_rx_queues ))
        [ "$rfs_queue" -lt 1024 ] && rfs_queue=1024
    else
        rfs_queue=4096
    fi

    # 网络核心参数优化
    write_if_changed /proc/sys/net/core/netdev_max_backlog 10000
    write_if_changed /proc/sys/net/core/netdev_budget 600
    write_if_changed /proc/sys/net/core/rps_sock_flow_entries "$rfs_global"

    # 调优物理网卡 Ring Buffer 和中断合并
    for iface in $WAN_IF $LAN_IF; do
        tune_ethtool "$iface"
    done

    local first_run=1
    local interval=5
    while true; do
        # ======================== 核心配置 ========================
        # WAN 口：硬中断从 CPU1 轮转，强制跳过 CPU0；
        #          RPS 使用多核掩码（CPU1-3），以利用多核处理高并发接收
        bind_nic_full "$WAN_IF" 1 yes "$rps_target"

        # LAN 口：硬中断从 CPU0 轮转，不跳过；
        #          RPS 与中断绑定同一核心，保持缓存局部性
        bind_nic_full "$LAN_IF" 0 no ""

        # pppoe-wan 多队列支持（如果存在，虚拟接口无硬中断，仅设 RPS）
        if [ -d /sys/class/net/pppoe-wan ]; then
            local q=0
            while [ -d "/sys/class/net/pppoe-wan/queues/rx-$q" ]; do
                write_if_changed "/sys/class/net/pppoe-wan/queues/rx-$q/rps_cpus" "$rps_target"
                write_if_changed "/sys/class/net/pppoe-wan/queues/rx-$q/rps_flow_cnt" "$rfs_queue"
                q=$((q + 1))
            done
        fi

        # 确保全局 RFS 条目数
        write_if_changed /proc/sys/net/core/rps_sock_flow_entries "$rfs_global"

        if [ "$first_run" -eq 1 ]; then
            first_run=0
            interval=30
        fi
        sleep "$interval"
    done
}