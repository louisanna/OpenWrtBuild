#!/bin/sh
# Set the root password from a hash injected at build time.
# The placeholder is replaced by the workflow with a $6$ (SHA-512) hash.
HASH='__ROOT_PASSWORD_HASH__'

case "$HASH" in
__ROOT_PASSWORD_HASH__)
	logger -t password_root "root password hash not injected, leaving root unchanged"
	exit 1
	;;
esac

CURRENT=$(awk -F: '$1=="root"{print $2}' /etc/shadow)
[ "$CURRENT" = "$HASH" ] && exit 0

awk -F: -v h="$HASH" 'BEGIN{OFS=":"} $1=="root"{$2=h} {print}' /etc/shadow > /tmp/shadow.new || exit 1
cat /tmp/shadow.new > /etc/shadow
rm -f /tmp/shadow.new
logger -t password_root "root password hash updated"
exit 0
