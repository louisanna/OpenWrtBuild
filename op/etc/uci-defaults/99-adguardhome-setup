#!/bin/sh
# First-boot setup: unpack AdGuardHome, enable the procd service.
# Data goes to /tmp/AdGuardHome, configuration stays at
# /usr/raspberry/AdGuardHome.yaml.

cd /usr/raspberry/ || exit 1

if [ ! -x AdGuardHome/AdGuardHome ]; then
	tar -xzf AdGuardHome_linux_amd64.tar.gz || exit 1
fi
rm -f AdGuardHome_linux_amd64.tar.gz

mkdir -p /tmp/AdGuardHome
/etc/init.d/AdGuardHome enable
/etc/init.d/AdGuardHome start

exit 0
