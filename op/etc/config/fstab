
config global
	option anon_swap '0'
	option anon_mount '0'
	option auto_swap '1'
	option auto_mount '1'
	option check_fs '0'
	option delay_root '15'

config mount
	option target '/overlay'
	option enabled '1'
	option device '/dev/nvme0n1p4'
	option fstype 'ext4'
	option is_rootfs '1'
	option enable_fsck '1'