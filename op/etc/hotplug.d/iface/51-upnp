#!/bin/sh
# Update miniupnpd's external_ip from the address assigned to the WAN
# interface every time WAN comes up. Falls back to a fixed address so
# UPnP clients always see a valid value.
[ "$ACTION" = "ifup" ] && [ "$INTERFACE" = "wan" ] || exit 0

FALLBACK_IP="112.20.126.123"

ip=$(ifstatus wan 2>/dev/null | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null)
[ -n "$ip" ] || ip="$FALLBACK_IP"

cur=$(uci -q get upnpd.config.external_ip 2>/dev/null)
[ "$cur" = "$ip" ] && exit 0

uci set upnpd.config.external_ip="$ip" 2>/dev/null || exit 0
uci commit upnpd
logger -t upnp-external-ip "external_ip set to $ip"
/etc/init.d/miniupnpd restart
