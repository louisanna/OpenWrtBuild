#!/bin/sh
# 仅在 WAN 接口上线时触发
[ "$ACTION" = "ifup" ] && [ "$INTERFACE" = "wan" ] || exit 0

# 获取公网 IP（你的原逻辑）
PUBLIC_IP=$(curl -4 -s myip.ipip.net | sed -n 's/当前 IP：\([0-9\.]*\).*/\1/p')

# 只有拿到有效 IP 才更新，避免清空配置
if [ -n "$PUBLIC_IP" ]; then
    uci set upnpd.config.external_ip="$PUBLIC_IP"
    uci commit upnpd
    /etc/init.d/miniupnpd restart
fi