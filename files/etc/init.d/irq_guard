#!/bin/sh /etc/rc.common

START=99
PIDFILE=/var/run/irq_guard.pid

WAN_IF="eth0"
LAN_IF="eth1"

start() {
    [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null && {
        echo "irq_guard already running."
        return 1
    }
    rm -f "$PIDFILE"
    daemon &
    echo $! > "$PIDFILE"
    echo "irq_guard started."
}

stop() {
    [ ! -f "$PIDFILE" ] && { echo "irq_guard not running."; return 1; }
    local pid
    pid=$(cat "$PIDFILE" 2>/dev/null)
    if [ -z "$pid" ]; then
        rm -f "$PIDFILE"
        echo "stale PID file removed."
        return 1
    fi
    echo "Stopping irq_guard (PID $pid)..."
    kill -TERM "$pid" 2>/dev/null
    sleep 2
    kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null
    rm -f "$PIDFILE"

}

write_if_changed() {
    local file="$1" value="$2" cur
    [ -f "$file" ] || return
    read -r cur < "$file" 2>/dev/null
    [ "$cur" != "$value" ] && echo "$value" > "$file" 2>/dev/null
}

get_nic_irqs() {
    local iface="$1"
    if [ -d "/sys/class/net/$iface/device/msi_irqs" ]; then
        for irq in $(ls "/sys/class/net/$iface/device/msi_irqs/" 2>/dev/null); do
            if grep -qE "(^| )${iface}-(TxRx|rx|tx)-[0-9]+" /proc/interrupts | grep -w "$irq:" >/dev/null 2>&1; then
                echo "$irq"
            fi
        done
        return
    fi
    grep -E "(^| )${iface}-(TxRx|rx|tx)-[0-9]+" /proc/interrupts | awk -F: '{print $1}' | tr -d ' '
}


tune_ethtool() {
    local iface="$1" target=1024
    local max_rx max_tx

    max_rx=$(ethtool -g "$iface" 2>/dev/null | sed -n '/Pre-set maximums:/,/Current hardware settings:/{/RX:/{s/.*RX:[[:space:]]*//p}}' | head -1)
    max_tx=$(ethtool -g "$iface" 2>/dev/null | sed -n '/Pre-set maximums:/,/Current hardware settings:/{/TX:/{s/.*TX:[[:space:]]*//p}}' | head -1)

    # 增加 || true 防止意外退出
    [ -n "$max_rx" ] && { ethtool -G "$iface" rx $((max_rx < target ? max_rx : target)) 2>/dev/null || true; }
    [ -n "$max_tx" ] && { ethtool -G "$iface" tx $((max_tx < target ? max_tx : target)) 2>/dev/null || true; }

    ethtool -c "$iface" 2>/dev/null | grep -q 'rx-usecs' && {
        ethtool -C "$iface" rx-usecs 16 tx-usecs 16 2>/dev/null || true
    }
}

# 绑定指定网卡的中断到从 start_cpu 开始的连续核心（轮转）
bind_irqs_to_cores() {
    local iface="$1" start_cpu="$2" cpu=$start_cpu
    for irq in $(get_nic_irqs "$iface"); do
        if [ -f "/proc/irq/$irq/smp_affinity_list" ]; then
            write_if_changed "/proc/irq/$irq/smp_affinity_list" "$cpu"
        elif [ -f "/proc/irq/$irq/smp_affinity" ]; then
            write_if_changed "/proc/irq/$irq/smp_affinity" "$(printf '%x' $((1 << cpu)))"
        fi
        cpu=$(( (cpu + 1) % cores ))
    done
}

configure_nic() {
    local iface="$1" mode="$2"
    [ ! -d "/sys/class/net/$iface" ] && return
    local q=0
    while [ -d "/sys/class/net/$iface/queues/rx-$q" ]; do
        local cpu_idx=$((q % cores))
        if [ "$mode" = "wan" ]; then
            write_if_changed "/sys/class/net/$iface/queues/rx-$q/rps_cpus" "$rps_target"
            write_if_changed "/sys/class/net/$iface/queues/rx-$q/rps_flow_cnt" "$rfs_queue"
            if [ "$cores" -gt 1 ]; then
                local xps_cpu=$(( cpu_idx % (cores - 1) + 1 ))
                write_if_changed "/sys/class/net/$iface/queues/tx-$q/xps_cpus" "$(printf '%x' $((1 << xps_cpu)))"
            else
                write_if_changed "/sys/class/net/$iface/queues/tx-$q/xps_cpus" "1"
            fi
        else
            local mask
            mask=$(printf "%x" $((1 << cpu_idx)))
            write_if_changed "/sys/class/net/$iface/queues/rx-$q/rps_cpus" "$mask"
            write_if_changed "/sys/class/net/$iface/queues/tx-$q/xps_cpus" "$mask"
            write_if_changed "/sys/class/net/$iface/queues/rx-$q/rps_flow_cnt" "$rfs_queue"
        fi
        q=$((q + 1))
    done
}

daemon() {
    trap 'exit 0' SIGTERM

    local wait=0
    while [ ! -d /sys/class/net/$WAN_IF/queues/rx-0 ] || [ ! -d /sys/class/net/$LAN_IF/queues/rx-0 ]; do
        sleep 1
        wait=$((wait + 1))
        [ "$wait" -ge 60 ] && exit 1
    done

    # 处理 irqbalance：记录是否由我们禁用
    if [ -x /etc/init.d/irqbalance ] && /etc/init.d/irqbalance enabled 2>/dev/null; then
        /etc/init.d/irqbalance stop 2>/dev/null
        /etc/init.d/irqbalance disable 2>/dev/null
    fi
    killall irqbalance 2>/dev/null

    local cores rps_target rfs_global rfs_queue
    cores=$(grep -c ^processor /proc/cpuinfo)

    # RPS target 跳过 CPU0
    if [ "$cores" -le 1 ]; then
        rps_target=0
    else
        rps_target=$(printf "%x" $(( (1 << cores) - 2 )))
    fi

    # 动态 RFS 全局条目：可用内存/32，封顶65536，保底8192
    local mem_kb
    mem_kb=$(awk '/MemAvailable/{print $2}' /proc/meminfo 2>/dev/null)
    if [ -n "$mem_kb" ] && [ "$mem_kb" -gt 0 ]; then
        rfs_global=$(( mem_kb / 32 ))
        [ "$rfs_global" -gt 65536 ] && rfs_global=65536
        [ "$rfs_global" -lt 8192 ] && rfs_global=8192
    else
        rfs_global=32768
    fi
    rfs_queue=4096

    for iface in $WAN_IF $LAN_IF; do
        tune_ethtool "$iface"
    done
    write_if_changed /proc/sys/net/core/rps_sock_flow_entries "$rfs_global"

    local first_run=1
    local interval=5
    while true; do
        # 固定起始核心，错开 WAN/LAN 硬中断分布
        local wan_start=0
        local lan_start=$(( cores / 2 ))   # 4核时为2，2核时为1
        bind_irqs_to_cores "$WAN_IF" $wan_start
        bind_irqs_to_cores "$LAN_IF" $lan_start

        configure_nic $WAN_IF wan
        configure_nic $LAN_IF lan

        # pppoe-wan 多队列支持
        if [ -d /sys/class/net/pppoe-wan ]; then
            local q=0
            while [ -d "/sys/class/net/pppoe-wan/queues/rx-$q" ]; do
                write_if_changed "/sys/class/net/pppoe-wan/queues/rx-$q/rps_cpus" "$rps_target"
                write_if_changed "/sys/class/net/pppoe-wan/queues/rx-$q/rps_flow_cnt" "$rfs_queue"
                q=$((q + 1))
            done
        fi

        write_if_changed /proc/sys/net/core/rps_sock_flow_entries "$rfs_global"

        if [ "$first_run" -eq 1 ]; then
            first_run=0
            interval=30
        fi
        sleep "$interval"
    done
}