#!/bin/sh /etc/rc.common

START=99
PIDFILE=/var/run/irq_guard.pid

# 修改为你实际使用的网卡名称
WAN_IF="eth0"
LAN_IF="eth1"

start() {
    [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null && {
        echo "irq_guard already running."
        return 1
    }
    rm -f "$PIDFILE"
    daemon &
    echo $! > "$PIDFILE"
    echo "irq_guard started."
}

stop() {
    [ ! -f "$PIDFILE" ] && { echo "irq_guard not running."; return 1; }
    local pid
    pid=$(cat "$PIDFILE" 2>/dev/null)
    if [ -z "$pid" ]; then
        rm -f "$PIDFILE"
        echo "stale PID file removed."
        return 1
    fi
    echo "Stopping irq_guard (PID $pid)..."
    kill -TERM "$pid" 2>/dev/null
    sleep 2
    kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null
    rm -f "$PIDFILE"
    [ -x /etc/init.d/irqbalance ] && {
        /etc/init.d/irqbalance enable 2>/dev/null
        /etc/init.d/irqbalance start 2>/dev/null
    }
    echo "irq_guard stopped."
}

write_if_changed() {
    local file="$1" value="$2" cur
    [ -f "$file" ] || return
    read -r cur < "$file" 2>/dev/null
    [ "$cur" != "$value" ] && echo "$value" > "$file" 2>/dev/null
}

# 严格限定只匹配带数字后缀的队列中断，排除 legacy/总中断
get_nic_irqs() {
    local iface="$1"
    if [ -d "/sys/class/net/$iface/device/msi_irqs" ]; then
        ls "/sys/class/net/$iface/device/msi_irqs/" 2>/dev/null
        return
    fi
    grep -E "(^| )${iface}-(TxRx|rx|tx)-[0-9]+" /proc/interrupts | awk -F: '{print $1}' | tr -d ' '
}

tune_ethtool() {
    local iface="$1" target=1024
    local max_rx max_tx

    max_rx=$(ethtool -g "$iface" 2>/dev/null | sed -n '/Pre-set maximums:/,/Current hardware settings:/{/RX:/{s/.*RX:[[:space:]]*//p}}' | head -1)
    max_tx=$(ethtool -g "$iface" 2>/dev/null | sed -n '/Pre-set maximums:/,/Current hardware settings:/{/TX:/{s/.*TX:[[:space:]]*//p}}' | head -1)

    [ -n "$max_rx" ] && ethtool -G "$iface" rx $((max_rx < target ? max_rx : target)) 2>/dev/null
    [ -n "$max_tx" ] && ethtool -G "$iface" tx $((max_tx < target ? max_tx : target)) 2>/dev/null

    ethtool -c "$iface" 2>/dev/null | grep -q 'rx-usecs' && \
        ethtool -C "$iface" rx-usecs 16 tx-usecs 16 2>/dev/null
}

configure_nic() {
    local iface="$1" mode="$2"
    [ ! -d "/sys/class/net/$iface" ] && return
    local q=0
    while [ -d "/sys/class/net/$iface/queues/rx-$q" ]; do
        local cpu_idx=$((q % cores))
        if [ "$mode" = "wan" ]; then
            write_if_changed "/sys/class/net/$iface/queues/rx-$q/rps_cpus" "$rps_target"
            # WAN XPS 也避开 CPU0，与 RPS 排除策略对齐
            local xps_cpu=$(( (cpu_idx + 1) % cores ))
            write_if_changed "/sys/class/net/$iface/queues/tx-$q/xps_cpus" "$(printf '%x' $((1 << xps_cpu)))"
        else
            local mask
            mask=$(printf "%x" $((1 << cpu_idx)))
            write_if_changed "/sys/class/net/$iface/queues/rx-$q/rps_cpus" "$mask"
            write_if_changed "/sys/class/net/$iface/queues/tx-$q/xps_cpus" "$mask"
            write_if_changed "/sys/class/net/$iface/queues/rx-$q/rps_flow_cnt" "$rfs_queue"
        fi
        q=$((q + 1))
    done
}

daemon() {
    trap 'exit 0' SIGTERM

    local wait=0
    while [ ! -d /sys/class/net/$WAN_IF/queues/rx-0 ] || [ ! -d /sys/class/net/$LAN_IF/queues/rx-0 ]; do
        sleep 1
        wait=$((wait + 1))
        [ "$wait" -ge 60 ] && exit 1
    done

    [ -x /etc/init.d/irqbalance ] && {
        /etc/init.d/irqbalance stop 2>/dev/null
        /etc/init.d/irqbalance disable 2>/dev/null
    }
    killall irqbalance 2>/dev/null

    local cores rps_target rfs_global rfs_queue
    cores=$(grep -c ^processor /proc/cpuinfo)
    if [ "$cores" -le 1 ]; then
        rps_target=0
    else
        rps_target=$(printf "%x" $(( (1 << cores) - 2 )))
    fi
    rfs_global=32768
    rfs_queue=4096

    for iface in $WAN_IF $LAN_IF; do
        tune_ethtool "$iface"
    done
    write_if_changed /proc/sys/net/core/rps_sock_flow_entries "$rfs_global"

    local first_run=1
    local interval=5
    while true; do
        local cpu=0
        for iface in $WAN_IF $LAN_IF; do
            for irq in $(get_nic_irqs "$iface"); do
                if [ -f "/proc/irq/$irq/smp_affinity_list" ]; then
                    write_if_changed "/proc/irq/$irq/smp_affinity_list" "$cpu"
                elif [ -f "/proc/irq/$irq/smp_affinity" ]; then
                    write_if_changed "/proc/irq/$irq/smp_affinity" "$(printf '%x' $((1 << cpu)))"
                fi
                cpu=$(( (cpu + 1) % cores ))
            done
        done

        configure_nic $WAN_IF wan
        configure_nic $LAN_IF lan

        # pppoe-wan（如果存在）
        if [ -d /sys/class/net/pppoe-wan ]; then
            if [ -d /sys/class/net/pppoe-wan/queues/rx-0 ]; then
                write_if_changed /sys/class/net/pppoe-wan/queues/rx-0/rps_cpus "$rps_target"
                write_if_changed /sys/class/net/pppoe-wan/queues/rx-0/rps_flow_cnt "$rfs_queue"
            fi
        fi

        write_if_changed /proc/sys/net/core/rps_sock_flow_entries "$rfs_global"

        if [ "$first_run" -eq 1 ]; then
            first_run=0
            interval=30
        fi
        sleep "$interval"
    done
}