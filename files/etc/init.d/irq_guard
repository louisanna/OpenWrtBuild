#!/bin/sh /etc/rc.common

START=99
PIDFILE=/var/run/irq_guard.pid

start() {
    [ -f $PIDFILE ] && kill -0 $(cat $PIDFILE) 2>/dev/null && {
        echo "irq_guard already running."; return 1
    }
    rm -f $PIDFILE
    daemon &
    echo $! > $PIDFILE
}

stop() {
    [ ! -f $PIDFILE ] && { echo "irq_guard not running."; return 1; }
    pid=$(cat $PIDFILE)
    kill -TERM $pid 2>/dev/null
    sleep 1
    kill -0 $pid 2>/dev/null && kill -9 $pid 2>/dev/null
    rm -f $PIDFILE
}

# 统一配置网卡 RPS / XPS / RFS
# 参数: $1=网卡名 $2=模式(wan/lan) $3=目标CPU掩码(wan时忽略)
configure_nic() {
    local iface=$1 mode=$2 cpu_mask=$3
    [ ! -d /sys/class/net/$iface ] && return
    q=0
    while [ -d /sys/class/net/$iface/queues/rx-$q ]; do
        if [ "$mode" = "wan" ]; then
            # WAN: RPS 使用全局 rps_target (排除CPU0)
            [ "$(cat /sys/class/net/$iface/queues/rx-$q/rps_cpus)" != "$rps_target" ] && \
                echo "$rps_target" > /sys/class/net/$iface/queues/rx-$q/rps_cpus
            # XPS 1:1
            xps_mask=$(printf "%x" $((1 << q)))
            [ "$(cat /sys/class/net/$iface/queues/tx-$q/xps_cpus)" != "$xps_mask" ] && \
                echo "$xps_mask" > /sys/class/net/$iface/queues/tx-$q/xps_cpus
        else
            # LAN: RPS/XPS 均 1:1
            mask=$(printf "%x" $((1 << q)))
            [ "$(cat /sys/class/net/$iface/queues/rx-$q/rps_cpus)" != "$mask" ] && \
                echo "$mask" > /sys/class/net/$iface/queues/rx-$q/rps_cpus
            [ "$(cat /sys/class/net/$iface/queues/tx-$q/xps_cpus)" != "$mask" ] && \
                echo "$mask" > /sys/class/net/$iface/queues/tx-$q/xps_cpus
            # RFS per-queue
            [ "$(cat /sys/class/net/$iface/queues/rx-$q/rps_flow_cnt 2>/dev/null)" != "$rfs_queue" ] && \
                echo "$rfs_queue" > /sys/class/net/$iface/queues/rx-$q/rps_flow_cnt
        fi
        q=$((q + 1))
    done
}

daemon() {
    trap 'exit 0' SIGTERM

    # 等待网卡就绪
    while [ ! -d /sys/class/net/eth0/queues/rx-0 ] || [ ! -d /sys/class/net/eth1/queues/rx-0 ]; do
        sleep 1
    done

    # 停用 irqbalance
    [ -x /etc/init.d/irqbalance ] && {
        /etc/init.d/irqbalance stop 2>/dev/null
        /etc/init.d/irqbalance disable 2>/dev/null
    }
    killall irqbalance 2>/dev/null

    # 初始化全局参数
    cores=$(grep -c ^processor /proc/cpuinfo)
    rps_target=$(printf "%x" $(( (1 << cores) - 2 )))
    rfs_global=32768
    rfs_queue=4096

    # ethtool 调优 & RFS 全局
    for iface in eth0 eth1; do
        ethtool -G $iface rx 1024 tx 1024 2>/dev/null
        ethtool -C $iface rx-usecs 16 tx-usecs 16 2>/dev/null
    done
    echo "$rfs_global" > /proc/sys/net/core/rps_sock_flow_entries 2>/dev/null

    while true; do
        # 硬件中断绑定 (动态匹配网卡中断号)
        cpu=0
        for irq in $(grep -E 'eth0-TxRx|eth1-TxRx' /proc/interrupts | awk -F: '{print $1}' | tr -d ' '); do
            expected=$(printf "%x" $((1 << cpu)))
            [ -f "/proc/irq/$irq/smp_affinity" ] && [ "$(< /proc/irq/$irq/smp_affinity)" != "$expected" ] && \
                echo "$expected" > /proc/irq/$irq/smp_affinity
            cpu=$(( (cpu + 1) % cores ))
        done

        # 网卡 RPS/XPS/RFS 配置
        configure_nic eth0 wan
        configure_nic eth1 lan

        # pppoe-wan (如果存在)
        if [ -f /sys/class/net/pppoe-wan/queues/rx-0/rps_cpus ]; then
            [ "$(< /sys/class/net/pppoe-wan/queues/rx-0/rps_cpus)" != "$rps_target" ] && \
                echo "$rps_target" > /sys/class/net/pppoe-wan/queues/rx-0/rps_cpus
            [ "$(< /sys/class/net/pppoe-wan/queues/rx-0/rps_flow_cnt 2>/dev/null)" != "$rfs_queue" ] && \
                echo "$rfs_queue" > /sys/class/net/pppoe-wan/queues/rx-0/rps_flow_cnt
        fi

        # RFS 全局流表恢复
        cur_global=$(< /proc/sys/net/core/rps_sock_flow_entries 2>/dev/null)
        [ -n "$cur_global" ] && [ "$cur_global" != "$rfs_global" ] && \
            echo "$rfs_global" > /proc/sys/net/core/rps_sock_flow_entries

        sleep 5
    done
}