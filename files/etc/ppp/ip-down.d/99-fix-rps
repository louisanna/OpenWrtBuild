#!/bin/sh
cores=$(grep -c ^processor /proc/cpuinfo)
rps_mask_no_cpu0=$(printf "%x" $(( ((1 << cores) - 1) & ~1 )))

# pppoe-wan 的 RPS + RFS
[ -f /sys/class/net/pppoe-wan/queues/rx-0/rps_cpus ] && echo "$rps_mask_no_cpu0" > /sys/class/net/pppoe-wan/queues/rx-0/rps_cpus
[ -f /sys/class/net/pppoe-wan/queues/rx-0/rps_flow_cnt ] && echo 4096 > /sys/class/net/pppoe-wan/queues/rx-0/rps_flow_cnt

# eth0 所有队列的 RPS（防止 PPP 重连时被清零）
q=0
while [ -d "/sys/class/net/eth0/queues/rx-$q" ]; do
    echo "$rps_mask_no_cpu0" > "/sys/class/net/eth0/queues/rx-$q/rps_cpus" 2>/dev/null
    q=$((q + 1))
done